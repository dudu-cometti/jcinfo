# ============================================================
# JC INFO - Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA versionar .env.local no git.
# ============================================================

# --- Supabase ---
# Encontrado em: Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta - usar somente em código de servidor (Server Actions/Route Handlers), nunca no client
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_NAME="JC Info"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp ---
# Número no formato internacional, somente dígitos (ex: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Tracking (opcional, preencher quando disponível) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
